# ==============================================================================
# Target E-Commerce REST API Microservice Container
# ==============================================================================
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY api_server.py .

EXPOSE 8080

ENTRYPOINT ["python3", "api_server.py", "--port", "8080"]
