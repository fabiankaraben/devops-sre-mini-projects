            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Active Virtual Users",
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
