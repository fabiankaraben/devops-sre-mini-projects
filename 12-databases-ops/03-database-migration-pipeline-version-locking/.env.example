# ==============================================================================
# PostgreSQL Database Migration Pipeline - Environment Configuration
# ==============================================================================

# Target PostgreSQL Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=migration_test_db

# Migrations Directory & Connection URL
MIGRATIONS_DIR=./migrations
DATABASE_URL=postgres://postgres:postgres@localhost:5432/migration_test_db?sslmode=disable
