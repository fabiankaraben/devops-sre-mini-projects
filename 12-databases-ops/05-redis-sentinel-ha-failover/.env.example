# ==============================================================================
# Redis Sentinel High Availability & Failover - Environment Configuration
# ==============================================================================

# Master Group Configuration
REDIS_MASTER_NAME=mymaster
REDIS_MASTER_HOST=localhost
REDIS_MASTER_PORT=6379

# Replica Node Ports
REDIS_REPLICA1_PORT=6380
REDIS_REPLICA2_PORT=6381

# Sentinel Consensus Quorum Ports
SENTINEL_1_PORT=26379
SENTINEL_2_PORT=26380
SENTINEL_3_PORT=26381

# Sentinel Timers (Milliseconds)
SENTINEL_QUORUM=2
SENTINEL_DOWN_AFTER=2000
SENTINEL_FAILOVER_TIMEOUT=5000
SENTINEL_PARALLEL_SYNCS=1
