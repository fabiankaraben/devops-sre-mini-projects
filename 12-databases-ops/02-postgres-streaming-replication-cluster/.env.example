# ==============================================================================
# PostgreSQL Streaming Replication Cluster - Environment Configuration
# ==============================================================================

# Primary Node Settings
POSTGRES_PRIMARY_HOST=localhost
POSTGRES_PRIMARY_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=production_db

# Standby Replica Node Settings
POSTGRES_REPLICA_HOST=localhost
POSTGRES_REPLICA_PORT=5433
POSTGRES_REPLICA_USER=postgres
POSTGRES_REPLICA_PASSWORD=postgres

# Replication Role & Physical Slot
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_password
REPLICATION_SLOT=standby_slot_1

# Workload Generation Parameters
WORKLOAD_RECORD_COUNT=50000
