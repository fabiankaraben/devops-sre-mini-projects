# ==============================================================================
# PostgreSQL Backup and Restore Validation - Environment Configuration
# ==============================================================================

# Primary Production Database Settings
POSTGRES_PRIMARY_HOST=localhost
POSTGRES_PRIMARY_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=production_db

# Validation / Test Database Settings (Isolated container)
POSTGRES_VALIDATION_HOST=localhost
POSTGRES_VALIDATION_PORT=5433
POSTGRES_VALIDATION_USER=postgres
POSTGRES_VALIDATION_PASSWORD=postgres
POSTGRES_VALIDATION_DB=validation_db

# Backup Storage and Retention Policy
BACKUP_DIR=./backups
RETENTION_DAYS=7
KEEP_LAST_COUNT=5
COMPRESSION_LEVEL=6
