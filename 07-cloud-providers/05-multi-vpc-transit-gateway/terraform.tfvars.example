# ==============================================================================
# Example Variables for Multi-VPC Transit Gateway Deployment
# ==============================================================================

# Target deployment AWS region
aws_region = "us-east-1"

# Custom endpoint for LocalStack emulator testing (leave empty for real AWS Cloud)
# aws_endpoint = "http://127.0.0.1:4566"
aws_endpoint = ""

# Resource naming prefix
project_name = "multi-vpc-hub-spoke"

# Target Availability Zone
availability_zone = "us-east-1a"

# Production Spoke VPC Allocations
prod_vpc_cidr        = "10.10.0.0/16"
prod_app_subnet_cidr = "10.10.1.0/24"
prod_db_subnet_cidr  = "10.10.2.0/24"

# Staging Spoke VPC Allocations
staging_vpc_cidr        = "10.20.0.0/16"
staging_app_subnet_cidr = "10.20.1.0/24"
staging_db_subnet_cidr  = "10.20.2.0/24"

# Shared Services Hub VPC Allocations
shared_vpc_cidr            = "10.30.0.0/16"
shared_tools_subnet_cidr   = "10.30.1.0/24"
shared_logging_subnet_cidr = "10.30.2.0/24"

# Common Resource Tags
tags = {
  Project      = "multi-vpc-hub-spoke"
  Environment  = "demo"
  ManagedBy    = "Terraform"
  Architecture = "MultiVPC-TransitGateway-HubSpoke"
}
