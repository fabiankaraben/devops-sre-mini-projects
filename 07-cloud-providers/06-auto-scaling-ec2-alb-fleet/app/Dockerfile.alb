# ==============================================================================
# Dockerfile for Local ALB (Nginx Load Balancer)
# ==============================================================================
FROM nginx:1.27-alpine

LABEL maintainer="DevOps & SRE Projects"
LABEL description="Local Application Load Balancer (ALB) Proxy"

# Copy Nginx upstream configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
