{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCICDDeploymentsBoundary",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject*",
        "s3:PutObject*",
        "s3:ListBucket*",
        "ecr:*",
        "lambda:*",
        "ecs:*",
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey*",
        "kms:DescribeKey",
        "cloudwatch:PutMetricData",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyPrivilegeEscalationAndDestruction",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organizations:*",
        "account:*",
        "aws-portal:*",
        "billing:*",
        "cloudtrail:*",
        "guardduty:*",
        "s3:DeleteBucket",
        "kms:ScheduleKeyDeletion"
      ],
      "Resource": "*"
    }
  ]
}
