{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadOnlyMetadataAndDescribe",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:Get*",
        "s3:Get*",
        "s3:List*",
        "kms:Describe*",
        "kms:Get*",
        "kms:List*",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "iam:Get*",
        "iam:List*",
        "iam:GenerateCredentialReport"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyMutatingActionsExplicitly",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:StartInstances",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteBucket",
        "kms:Create*",
        "kms:Delete*",
        "kms:Disable*",
        "kms:ScheduleKeyDeletion",
        "iam:Create*",
        "iam:Delete*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Update*"
      ],
      "Resource": "*"
    }
  ]
}
