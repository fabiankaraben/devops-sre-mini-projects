{
  "name": "environment-delivery-api",
  "version": "1.0.0",
  "description": "Environment-aware Cloud-Native REST service demonstrating GitLab CI multi-environment delivery pipelines",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage .nyc_output node_modules"
  },
  "keywords": [
    "devops",
    "sre",
    "gitlab-ci",
    "continuous-delivery",
    "staging",
    "production",
    "multi-environment"
  ],
  "author": "DevOps SRE Mini Projects",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.3.1",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
