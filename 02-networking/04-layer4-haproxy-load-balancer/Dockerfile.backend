# ==============================================================================
# Dockerfile for Backend TCP Server Instance
# ==============================================================================
FROM python:3.12-alpine

LABEL maintainer="DevOps & SRE Educational Projects"
LABEL description="Python TCP/HTTP backend node for HAProxy load balancing demonstration"

WORKDIR /app

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY backend/server.py .

RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8000

ENV PORT=8000 \
    PYTHONUNBUFFERED=1

HEALTHCHECK --interval=3s --timeout=2s --retries=2 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1

CMD ["python3", "server.py"]
