FROM alpine:3.20

LABEL maintainer="DevOps & SRE Mini Projects"
LABEL description="WireGuard VPN Mesh Gateway with Kernel/Routing tools"

# Install networking, WireGuard, routing, and diagnostic tools
RUN apk update && \
    apk add --no-cache \
        bash \
        wireguard-tools \
        iptables \
        iproute2 \
        tcpdump \
        iperf3 \
        curl \
        bind-tools \
        ca-certificates && \
    rm -rf /var/cache/apk/*

WORKDIR /app
COPY config/ /config/
COPY scripts/entrypoint-gateway.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

HEALTHCHECK --interval=3s --timeout=2s --retries=5 \
    CMD wg show wg0 >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/entrypoint.sh"]
