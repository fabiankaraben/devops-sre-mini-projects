FROM python:3.11-alpine

LABEL maintainer="DevOps & SRE Mini Projects"
LABEL description="Interactive SRE Dashboard for Envoy Canary & Circuit Breaker"

RUN apk add --no-cache curl bash && rm -rf /var/cache/apk/*

WORKDIR /app
COPY web/ /app/

ENV PYTHONUNBUFFERED=1
ENV PORT=8080

EXPOSE 8080

HEALTHCHECK --interval=3s --timeout=2s --retries=5 \
    CMD curl -f http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["python3", "/app/server.py"]
