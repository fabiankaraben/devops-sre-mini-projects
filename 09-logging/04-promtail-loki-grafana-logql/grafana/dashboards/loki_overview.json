      "datasource": { "type": "loki", "uid": "Loki" },
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=\"app_logs\"}",
          "refId": "A"
        }
