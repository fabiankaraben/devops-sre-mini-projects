      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "🔥 Error Rate by Application",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (app) (rate({job=\"app_logs\", level=\"ERROR\"}[1m]))",
          "legendFormat": "{{app}} (errors/s)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "📊 Log Ingestion Rate by Severity Level",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (level) (rate({job=\"app_logs\"}[1m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "🌐 HTTP Status Code Distribution (Last 5m)",
      "type": "barchart",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (status_code) (count_over_time({job=\"app_logs\"} | json [5m]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "⏱️ Top Endpoints by Max Latency (ms)",
      "type": "bargauge",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "max by (endpoint) (quantile_over_time(0.95, {job=\"app_logs\"} | json | unwrap duration_ms [5m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 14 },
