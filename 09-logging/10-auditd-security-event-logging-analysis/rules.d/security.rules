# ==============================================================================
# /etc/audit/rules.d/security.rules - Linux Security Audit Framework Rules
# Standard Baseline: CIS Linux Benchmark / NIST SP 800-53
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Audit System Configuration & Buffer Limits
# ------------------------------------------------------------------------------
# Delete all previous active rules
-D

# Set buffer size (number of audit message buffers)
-b 8192

# Set failure mode (1 = printk to syslog, 2 = kernel panic)
-f 1

# Rate limit (messages per second)
-r 0

# ------------------------------------------------------------------------------
# 2. Identity & Account Changes (File Integrity Monitoring - FIM)
# ------------------------------------------------------------------------------
# Monitor modifications and permission changes to user database files
-w /etc/passwd -p wa -k identity_changes
-w /etc/shadow -p wa -k identity_changes
-w /etc/group -p wa -k identity_changes
-w /etc/gshadow -p wa -k identity_changes
-w /etc/security/opasswd -p wa -k identity_changes

# ------------------------------------------------------------------------------
# 3. Privilege Escalation & Sudo Configuration Monitoring
# ------------------------------------------------------------------------------
# Monitor modifications to sudoers and elevated permission maps
-w /etc/sudoers -p wa -k privilege_escalation
-w /etc/sudoers.d/ -p wa -k privilege_escalation

# Monitor SSH daemon configuration tampering
-w /etc/ssh/sshd_config -p wa -k sshd_tamper
-w /etc/ssh/sshd_config.d/ -p wa -k sshd_tamper

# ------------------------------------------------------------------------------
# 4. Privilege Escalation System Calls (setuid / setgid)
# ------------------------------------------------------------------------------
-a always,exit -F arch=b64 -S setuid,setgid,setreuid,setregid,setresuid,setresgid -k priv_escalation_syscalls
-a always,exit -F arch=b32 -S setuid,setgid,setreuid,setregid,setresuid,setresgid -k priv_escalation_syscalls

# ------------------------------------------------------------------------------
# 5. Process Execution (execve) Monitoring for Non-Root / Elevated Users
# ------------------------------------------------------------------------------
-a always,exit -F arch=b64 -S execve,execveat -F auid>=1000 -F auid!=-1 -k user_commands
-a always,exit -F arch=b32 -S execve,execveat -F auid>=1000 -F auid!=-1 -k user_commands

# ------------------------------------------------------------------------------
# 6. File Deletion and Renaming Monitoring
# ------------------------------------------------------------------------------
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=-1 -k file_deletion
-a always,exit -F arch=b32 -S unlink,unlinkat,rename,renameat -F auid>=1000 -F auid!=-1 -k file_deletion

# ------------------------------------------------------------------------------
# 7. Kernel Module Injection & Unloading Monitoring
# ------------------------------------------------------------------------------
-w /sbin/insmod -p x -k kernel_modules
-w /sbin/rmmod -p x -k kernel_modules
-w /sbin/modprobe -p x -k kernel_modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel_modules
